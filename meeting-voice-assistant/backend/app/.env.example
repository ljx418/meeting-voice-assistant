# Copy to .env for local development. Do not commit real secrets.

# API auth
API_KEY=
DATA_SERVICE_REQUIRE_API_KEY=true
DATA_SERVICE_ALLOWED_WORKSPACE_ROOTS=/tmp
DATA_SERVICE_ALLOWED_SOURCE_ROOTS=/tmp
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Frontend dev can set VITE_DATA_SERVICE_API_KEY to the same API_KEY value.

# ASR
ASR_ENGINE=mock

# LLM
LLM_PROVIDER=minimax
LLM_DASHSCOPE_API_KEY=
LLM_MINIMAX_API_KEY=
LLM_DEEPSEEK_API_KEY=
LLM_MINIMAX_ENDPOINT=https://api.minimax.chat/v1
LLM_MINIMAX_MODEL=MiniMax-Text-01
LLM_DEEPSEEK_ENDPOINT=https://api.deepseek.com
LLM_DEEPSEEK_MODEL=deepseek-chat

# LLMWiki
MINIMAX_API_KEY=
LLMWIKI_LLM_PROVIDER=http
LLMWIKI_LLM_API_BASE=https://api.minimax.io/v1
LLMWIKI_LLM_API_KEY_ENV=MINIMAX_API_KEY
LLMWIKI_LLM_MODEL=MiniMax-M2.7
LLMWIKI_LLM_TIMEOUT=60
LLMWIKI_LLM_MAX_RETRIES=2
LLMWIKI_COMPILE_ON_INGEST=true

# Audio cache
AUDIO_CACHE_ENABLED=true
AUDIO_CACHE_DIR=/tmp/meeting-voice-assistant/audio_cache

# GraphRAG
GRAPHRAG_AUTO_INDEX=false
GRAPHRAG_SERVICE_URL=http://localhost:8002
GRAPHRAG_SERVICE_PORT=8002
GRAPHRAG_WORKSPACE=/tmp/meeting-voice-assistant/rag_workspace

# Watch folder
WATCH_FOLDER_PATH=
WATCH_FOLDER_ENABLED=false
WATCH_FOLDER_AUTO_INDEX_ON_CHANGE=true
