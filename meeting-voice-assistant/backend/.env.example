# 会议语音助手配置模板
# 复制此文件为 .env 并填入真实值

# =============================================================================
# ASR 引擎配置
# =============================================================================
# ASR 引擎选择: mock, aliyun, sensevoice, dashscope, dashscope_file,
#               dashscope_realtime, funasr, funasr_realtime
ASR_ENGINE=dashscope

# Mock ASR 配置 (用于测试)
MOCK_ASR_DELAY=0.8

# 阿里云 ASR 配置 (当 ASR_ENGINE=aliyun 时使用)
ALIYUN_ENDPOINT=wss://nls-gateway.cn-shanghai.aliyuncs.com/ws/v1
ALIYUN_ACCESS_KEY_ID=your_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_APP_KEY=your_app_key_here
ALIYUN_REGION=cn-shanghai

# SenseVoice 本地部署配置 (当 ASR_ENGINE=sensevoice 时使用)
SENSEVOICE_MODE=local
SENSEVOICE_ENDPOINT=http://localhost:8000
SENSEVOICE_API_KEY=

# DashScope ASR 配置 (当使用 DashScope 引擎时使用)
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/audio/asr
DASHSCOPE_MODEL=qwen3-asr-flash

# FunASR 本地服务配置 (当 ASR_ENGINE=funasr/funasr_realtime 时使用)
FUNASR_ENDPOINT=http://localhost:8001
FUNASR_API_KEY=
FUNASR_TIMEOUT=3600
FUNASR_MODEL=paraformer-zh
FUNASR_VAD_MODEL=fsmn-vad
FUNASR_SPK_MODEL=cam++
FUNASR_PUNC_MODEL=ct-punc
FUNASR_DEVICE=cpu
FUNASR_BATCH_SIZE_S=300

# FunASR 实时识别配置
FUNASR_WS_URL=ws://localhost:10096
FUNASR_REALTIME_MODE=2pass
FUNASR_CHUNK_DURATION=3.0
FUNASR_MIN_CHUNK_DURATION=1.0
FUNASR_MAX_BUFFER_DURATION=10.0
FUNASR_MAX_FILE_SIZE_MB=500

# =============================================================================
# LLM 分析配置
# =============================================================================
# LLM 提供商: dashscope, minimax, deepseek
LLM_PROVIDER=dashscope
LLM_API_KEY=your_llm_api_key
LLM_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation
LLM_MODEL=qwen-plus

# MiniMax LLM 配置 (音频分析用)
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_ENDPOINT=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-Text-01

# DeepSeek LLM 配置 (备用)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_ENDPOINT=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 音频分析器 LLM 提供商: minimax, deepseek
AUDIO_ANALYZER_LLM_PROVIDER=minimax

# =============================================================================
# 音频配置
# =============================================================================
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_BUFFER_DURATION=1.0

# =============================================================================
# 缓存配置
# =============================================================================
AUDIO_CACHE_ENABLED=true
AUDIO_CACHE_DIR=./audio_cache

# =============================================================================
# 日志配置
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=

# =============================================================================
# API 认证配置
# =============================================================================
# 留空或不设置 = 禁用认证（本地开发模式）
# 生产环境建议使用随机生成: openssl rand -hex 32
API_KEY=

# =============================================================================
# GraphRAG 配置
# =============================================================================
GRAPHRAG_AUTO_INDEX=false
GRAPHRAG_SERVICE_URL=http://localhost:8002
