        </mxCell>
        <mxCell id="cur_exec" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#38BDF8;align=left;spacingLeft=12;fontSize=13" value="产物层&lt;br&gt;&lt;br&gt;• `workspace/summary`&lt;br&gt;• `workspace/llmwiki`&lt;br&gt;• `workspace/graphrag`&lt;br&gt;• `workspace/quality/feedback.jsonl`&lt;br&gt;• `workspace/quality/correction_rules.json`&lt;br&gt;• `row` 保持只读，不被改写" vertex="1">
