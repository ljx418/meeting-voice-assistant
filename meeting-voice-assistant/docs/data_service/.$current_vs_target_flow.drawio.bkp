        <mxCell id="gap_infra" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;align=left;spacing=12;spacingLeft=14;fontSize=14;fontColor=#111827;arcSize=6" value="差距 4：蒸馏过程缺 source 级流水线&lt;br&gt;&lt;br&gt;• distill source/unit/profile_debug 已可查&lt;br&gt;• LLMWiki 页面和 GraphRAG 图谱可分别查看&lt;br&gt;• 缺 `原始文件 -&gt; distill units -&gt; LLMWiki -&gt; GraphRAG` 的用户视图&lt;br&gt;• 缺页面/节点反向追溯 source" vertex="1">
          <mxGeometry height="140" width="400" x="600" y="845" as="geometry" />
        </mxCell>
        <mxCell id="gap_quality" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;align=left;spacing=12;spacingLeft=14;fontSize=14;fontColor=#111827;arcSize=6" value="差距 5：监听与空状态仍需产品化&lt;br&gt;&lt;br&gt;• 已有手动目录扫描和待刷新队列&lt;br&gt;• 后台常驻 watcher、暂停/恢复和自动刷新仍未实现&lt;br&gt;• 删除文件后的停用/重建向导仍偏弱&lt;br&gt;• API key、空 workspace、构建失败时还需更清晰引导" vertex="1">
