        <mxCell id="14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" value="收口重点&#xa;1. 先稳定 distill&#xa;2. 再迁移 Graph 职责&#xa;3. 最后再继续加强 UI 和 Agent 能力" vertex="1">
