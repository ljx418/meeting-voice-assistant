        <mxCell id="completion_risk" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF7ED;strokeColor=#EA580C;fontSize=13;align=left;spacingLeft=14" value="完成度与主要风险&#10;&#10;完成度：&#10;V1.0 M0-M4：100%&#10;V1.1-A/B/C/D：100%（限定文本源 workspace query）&#10;RC1/RC2/RC3/RC5：100%&#10;RC4 trace fix + re-smoke：100%（受限范围）&#10;S1 session precise navigation：100%（限定文本源 session query）&#10;&#10;高风险：&#10;能力声明被扩大成 all-session / all-source-type&#10;&#10;中高风险：&#10;非文本 source type contract 缺口&#10;前后端合同漂移&#10;fixtures / artifacts 泄漏本地路径" vertex="1">
          <mxGeometry height="330" width="620" x="790" y="1390" as="geometry" />
