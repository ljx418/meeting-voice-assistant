        <mxCell id="section_arch" value="七层目标架构" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=20;fontStyle=1;align=center" vertex="1" parent="1">
