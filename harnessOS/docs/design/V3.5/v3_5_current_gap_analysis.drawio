        <mxCell id="p2" value="Plane-2&lt;br&gt;Protocol App Server&lt;br&gt;&lt;br&gt;JSON-RPC / HTTP / stdio&lt;br&gt;method / event / error schema&lt;br&gt;approval.respond / events.subscribe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE68A;strokeColor=#D97706;fontSize=13;align=center" vertex="1" parent="1">
