        <mxCell id="section_gap" value="当前状态 -&gt; 差距 -&gt; 目标状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=20;fontStyle=1;align=center" vertex="1" parent="1">
          <mxGeometry x="70" y="610" width="2060" height="52" as="geometry" />
        </mxCell>
        <mxCell id="current" value="当前状态&lt;br&gt;&lt;br&gt;• 已有 JSON-RPC / HTTP / stdio 基础入口&lt;br&gt;• Core 对象可被消费&lt;br&gt;• Pack / Connector / Job / Artifact / Governance 合同可作为基线&lt;br&gt;• 缺少外部 App 接入层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;align=left;spacingLeft=14;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="100" y="700" width="560" height="190" as="geometry" />
        </mxCell>
        <mxCell id="gap" value="核心差距&lt;br&gt;&lt;br&gt;• 无 formal SDK 默认面&lt;br&gt;• 无 method / event / error schema registry&lt;br&gt;• 无 local capability token&lt;br&gt;• 无 native EventSource auth&lt;br&gt;• 无 BFF / template / embed contract&lt;br&gt;• 无平台中立 reference app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;align=left;spacingLeft=14;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="820" y="700" width="560" height="190" as="geometry" />
        </mxCell>
        <mxCell id="target" value="目标状态&lt;br&gt;&lt;br&gt;• 外部 App 通过 SDK / BFF 接入&lt;br&gt;• Token 绑定 scope / origin / capabilities&lt;br&gt;• Event bridge 支持 replay cursor&lt;br&gt;• approval.respond 统一审批且幂等&lt;br&gt;• templates 可生成 pack / connector&lt;br&gt;• reference app 不改 Core 接入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;align=left;spacingLeft=14;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="1540" y="700" width="560" height="190" as="geometry" />
        </mxCell>
        <mxCell id="eg1" edge="1" source="current" target="gap" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284C7;endArrow=block;endFill=1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eg2" edge="1" source="gap" target="target" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D97706;endArrow=block;endFill=1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="section_summary" value="开发计划摘要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;fontSize=20;fontStyle=1;align=center" vertex="1" parent="1">
          <mxGeometry x="70" y="970" width="2060" height="52" as="geometry" />
        </mxCell>
        <mxCell id="summary_now" value="当前开发到哪了&lt;br&gt;&lt;br&gt;• V3.5 规划完成，尚未进入代码实施&lt;br&gt;• 七层目标架构已确定&lt;br&gt;• P0 条件已明确&lt;br&gt;• 尚无 SDK / BFF / Event Bridge / token / schema registry / reference app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;align=left;spacingLeft=14;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="100" y="1045" width="620" height="150" as="geometry" />
        </mxCell>
        <mxCell id="summary_next" value="下一阶段开发什么&lt;br&gt;&lt;br&gt;1. V3.5-0 Contract Inventory&lt;br&gt;2. V3.5-A Schema + Error Registry&lt;br&gt;3. V3.5-B Capability Token&lt;br&gt;4. V3.5-C Browser Event Bridge&lt;br&gt;然后进入 Python SDK / TS SDK / hooks / BFF / Template / Embed / Reference App" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;align=left;spacingLeft=14;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="790" y="1045" width="620" height="150" as="geometry" />
        </mxCell>
        <mxCell id="summary_final" value="最终开发成什么样&lt;br&gt;&lt;br&gt;External App -&gt; SDK / hooks -&gt; BFF -&gt; token + scope -&gt; JSON-RPC / native EventSource / fetch stream -&gt; Core contracts&lt;br&gt;&lt;br&gt;平台中立 reference app 不改 Core 完成接入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;align=left;spacingLeft=14;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="1480" y="1045" width="620" height="150" as="geometry" />
        </mxCell>

