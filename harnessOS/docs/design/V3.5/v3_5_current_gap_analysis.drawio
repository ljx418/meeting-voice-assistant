        </mxCell>
        <mxCell id="p6" value="Plane-6&lt;br&gt;Connector / Tool / Store&lt;br&gt;&lt;br&gt;MCP / stdio / HTTP connectors&lt;br&gt;外部服务 / store / tools&lt;br&gt;V3.5 提供 connector template" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;fontSize=13;align=center" vertex="1" parent="1">
          <mxGeometry x="1645" y="390" width="230" height="135" as="geometry" />
