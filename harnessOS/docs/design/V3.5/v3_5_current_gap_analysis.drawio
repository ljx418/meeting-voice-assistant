        <mxCell id="subtitle" value="核心维护文件对：v3_5_current_gap_analysis.md + v3_5_current_gap_analysis.drawio。V3.5 目标是新增 Application Adaptation Layer，不重构 Core。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=14;align=center" vertex="1" parent="1">
          <mxGeometry x="290" y="85" width="1620" height="52" as="geometry" />
