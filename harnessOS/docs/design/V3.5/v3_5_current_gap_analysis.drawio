        <mxCell id="governance" value="治理链路贯穿：token -&gt; scope -&gt; capability -&gt; JSON-RPC / native EventSource / fetch stream -&gt; Core approval / job / artifact / trace&lt;br&gt;SDK / BFF / Event Bridge 不得绕过 Core governance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=13;align=center" vertex="1" parent="1">
