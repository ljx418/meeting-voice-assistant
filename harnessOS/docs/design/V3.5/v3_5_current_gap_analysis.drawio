        <mxCell id="mh" value="V3.5-H&lt;br&gt;Embed Contract&lt;br&gt;Plane-0 / 1 / 2 / 3&lt;br&gt;EmbedDefinition、chat/job/artifact/approval/trace/business event union" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontSize=13;align=center" vertex="1" parent="1">
