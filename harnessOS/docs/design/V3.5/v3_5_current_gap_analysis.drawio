          <mxGeometry x="1040" y="255" width="270" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="Plane-4&lt;br&gt;Runtime Adapter&lt;br&gt;&lt;br&gt;执行边界 / runtime 适配&lt;br&gt;治理注入&lt;br&gt;V3.5 不新增 runtime 入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=13;align=center" vertex="1" parent="1">
          <mxGeometry x="1360" y="255" width="240" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="Plane-5&lt;br&gt;Domain Pack&lt;br&gt;&lt;br&gt;workflow / skill / policy&lt;br&gt;artifact kinds / pack assembly&lt;br&gt;V3.5 提供模板" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;fontSize=13;align=center" vertex="1" parent="1">
