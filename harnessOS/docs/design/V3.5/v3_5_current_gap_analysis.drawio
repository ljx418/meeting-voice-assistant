        <mxCell id="p0" value="Plane-0&lt;br&gt;Product UI / External Business App&lt;br&gt;&lt;br&gt;业务前端 / 外部 App / 嵌入面板&lt;br&gt;V3.5 的直接使用方" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=13;align=center" vertex="1" parent="1">
