        <mxCell id="p5-title" value="V9 验收门槛与停止条件" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111827;fontColor=#ffffff;fontSize=26;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="40" width="1500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p5-pass" value="必须证明&#xa;1. AgentExecutionEnvelope evidence&#xa;2. CapabilityResolver decision&#xa;3. user_confirmed=true 或 human_authorization_ref&#xa;4. kill switch / timeout / rollback&#xa;5. attempt history and artifact lineage&#xa;6. fan-in / fan-out / failure recovery&#xa;7. coding diff / test / review loop&#xa;8. Studio BFF and browser denylist&#xa;9. redaction and claim scan PASS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="170" width="440" height="430" as="geometry" />
        </mxCell>
        <mxCell id="p5-stop" value="停止条件&#xa;1. source=agent 默认 durable mutation&#xa;2. durable mutation 缺少 user_confirmed / human_authorization_ref&#xa;3. ready for review 被写成 ready&#xa;4. terminal worker 变成 unrestricted shell&#xa;5. Studio 直接写 runtime truth&#xa;6. raw secret / raw prompt 泄露&#xa;7. auto commit / push / deploy 无审批&#xa;8. V9-8 在 evidence 缺失时执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="170" width="440" height="430" as="geometry" />
        </mxCell>
        <mxCell id="p5-claim" value="允许最终声明&#xa;V9 complete: high-risk Agent execution and workflow productization baseline ready for review.&#xa;&#xa;禁止改写为&#xa;production ready&#xa;Agent executor ready&#xa;full multi-Agent orchestration ready&#xa;autonomous coding workflow ready&#xa;complete Workflow Studio ready&#xa;unrestricted terminal worker ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1110" y="170" width="400" height="430" as="geometry" />
        </mxCell>
        <mxCell id="p5-cmd" value="验收命令规划&#xa;xmllint --noout docs/design/V9.x/v9_current_gap_analysis.drawio&#xa;rg forbidden claims docs/design/V9.x&#xa;未来各阶段：pytest tests/test_v9_*.py -q + stage-specific E2E evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="230" y="720" width="1140" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
