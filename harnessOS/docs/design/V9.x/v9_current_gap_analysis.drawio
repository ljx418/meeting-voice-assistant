        </mxCell>
        <mxCell id="p7-m7" value="M7 / V9-7&#xa;Production Governance / Evidence Hardening&#xa;+ Terminal Automation Gate&#xa;evidence: design / incident / credential / approval&#xa;not production automation ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1240" y="360" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p7-m8" value="M8 / V9-8&#xa;Final Acceptance&#xa;evidence: V9-0..V9-7 packages + claim scan + redaction + drawio XML&#xa;claim: V9 baseline ready for review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="630" width="740" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p7-note" value="出门注意：M1 只允许进入合同审计，不等于 runtime implementation approval；M8 不允许把 baseline ready for review 改写为 production ready / Agent executor ready / full orchestration ready。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="830" width="1240" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v9-page-8" name="08 实现前规格闭环">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p8-title" value="V9 实现前规格闭环：规划文档不能直接替代运行时证据" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111827;fontColor=#ffffff;fontSize=26;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="40" width="1500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p8-auth" value="共享合同&#xa;HumanAuthorizationRef&#xa;issuer / scope / expiry / operation_hash / target_refs / revocation / audit_ref&#xa;&#xa;硬规则：durable mutation 需要 user_confirmed=true 或 valid human_authorization_ref" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="150" width="470" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p8-v92" value="V9-2 Controlled Executor Spec&#xa;action allowlist / state transition / append-only evidence / redaction / negative tests&#xa;&#xa;不得：source=agent direct mutation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="150" width="420" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p8-v93" value="V9-3 Orchestration Spec&#xa;serial / parallel / fan-in / fan-out / lost worker recovery / attempt history / producer_agent_id / producer_attempt_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="150" width="470" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p8-v94" value="V9-4 Coding Workflow Spec&#xa;diff / test / review / fix loop&#xa;&#xa;停止：no auto commit / auto push / auto deploy / unreviewed patch apply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="430" width="470" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p8-v956" value="V9-5 / V9-6 Specs&#xa;Terminal Worker：command tiers / filesystem / network / secret policy / diff capture&#xa;Studio：separate PRD / BFF / DTO / browser denylist / no runtime truth write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="430" width="420" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p8-v978" value="V9-7 / V9-8 Specs&#xa;Governance + evidence hardening + terminal automation gate&#xa;Final acceptance 只能在 V9-0..V9-7 evidence packages 存在后执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="430" width="470" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p8-note" value="当前允许：V9-1 contract audit / implementation-readiness audit；P0 schema / fixture / evidence package 外部审计。&#xa;当前禁止：V9-1 runtime implementation、把 planned specs 当 runtime evidence、声明 Agent executor ready / production ready / full orchestration ready。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="170" y="760" width="1260" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v9-page-9" name="09 P0 Schema Fixture Evidence">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p9-title" value="V9 P0 Implementation Package：Schema / Fixture / Evidence / CI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111827;fontColor=#ffffff;fontSize=26;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="40" width="1500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p9-schema" value="Machine-readable Schemas&#xa;AgentExecutionPolicy&#xa;AgentExecutionEnvelope&#xa;HumanAuthorizationRef&#xa;CapabilityResolverDecision&#xa;ExecutionEvidence&#xa;OrchestrationMessage&#xa;ArtifactLineageRecord&#xa;EvidencePackage&#xa;FinalAcceptanceDashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="390" height="390" as="geometry" />
        </mxCell>
        <mxCell id="p9-fixture" value="Negative Fixtures&#xa;source_agent_durable_mutation&#xa;expired_human_authorization_ref&#xa;raw_secret_in_evidence&#xa;artifact_lineage_missing_producer_attempt&#xa;&#xa;Evidence Samples&#xa;V9-1 contract_freeze sample&#xa;V9-8 planning-only reject sample" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="160" width="390" height="390" as="geometry" />
        </mxCell>
        <mxCell id="p9-validator" value="Validator / CI Gate&#xa;/usr/bin/python3 -m json.tool schemas/*.json&#xa;/usr/bin/python3 -m json.tool fixtures/**/*.json&#xa;xmllint drawio&#xa;rg forbidden claims&#xa;redaction scan&#xa;&#xa;规则：schema 和 fixture 支撑实现前审计，不等于 runtime evidence。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1120" y="160" width="390" height="390" as="geometry" />
        </mxCell>
        <mxCell id="p9-note" value="P0 包用途：让 V9-1 到 V9-4 的开发前审计可机器校验。&#xa;P0 包边界：不能让 V9-1 runtime implementation 自动变成 GO，也不能让 V9-8 从 planning docs alone 执行。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="700" width="1280" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v9-page-10" name="10 V9-1 到 V9-4 开发前门禁">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p10-title" value="V9-1 到 V9-4：Audit PASS 与 Runtime PASS 的边界" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111827;fontColor=#ffffff;fontSize=26;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="40" width="1500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10-v91" value="V9-1&#xa;External Implementation-Readiness Audit: GO&#xa;&#xa;需要：contract + schema + fixture + No False Green&#xa;&#xa;Runtime implementation: NO-GO until external audit accepted + human decision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="160" width="330" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p10-v92" value="V9-2&#xa;Controlled Executor Runtime&#xa;NO-GO until V9-1 PASS&#xa;&#xa;硬门禁：user_confirmed=true OR valid human_authorization_ref&#xa;source=agent default durable mutation denied" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="160" width="330" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p10-v93" value="V9-3&#xa;Multi-Agent Orchestration Runtime&#xa;NO-GO until V9-2 PASS&#xa;&#xa;必须证明：serial / parallel / fan-in / fan-out / lost worker recovery / lineage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="830" y="160" width="330" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p10-v94" value="V9-4&#xa;Autonomous Coding Workflow&#xa;NO-GO until V9-2 + V9-3 PASS&#xa;&#xa;必须证明：diff / test / review / fix loop&#xa;停止：auto commit / push / deploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1210" y="160" width="330" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p10-evidence" value="每阶段 Runtime PASS 必须有：runtime-backed evidence package、test results、redaction PASS、claim scan PASS、human decision refs（高风险阶段）、audit_ref 和 correlation_id。&#xa;&#xa;Audit PASS 只证明设计可开工；Runtime PASS 才证明功能完成。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="620" width="1300" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v9-page-11" name="11 关键架构变更审计图">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p11-title" value="V9 关键架构变更审计图：从 Agent Proposal 到受控 Runtime Evidence" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111827;fontColor=#ffffff;fontSize=26;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="40" width="1500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p11-agent" value="Station Agent&#xa;role / goal / memory / tools / skills / MCP&#xa;&#xa;只能 propose / handoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="180" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p11-env" value="AgentExecutionEnvelope&#xa;operation / source / actor / target_refs / payload_refs&#xa;&#xa;request evidence, not runtime truth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="180" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p11-cap" value="CapabilityResolver&#xa;deny-by-default&#xa;policy / source / operation / scope&#xa;&#xa;source=agent durable mutation denied" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="180" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p11-auth" value="HumanAuthorizationRef / ApprovalGate&#xa;issuer / expiry / operation_hash / target_refs&#xa;&#xa;durable mutation requires user_confirmed OR valid ref" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1170" y="180" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p11-exec" value="Controlled Runtime / Executor Slice&#xa;allowlisted actions only&#xa;kill switch / timeout / idempotency / rollback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="480" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p11-orch" value="OrchestrationCoordinator&#xa;serial / parallel / fan-in / fan-out&#xa;attempt history / recovery / artifact lineage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="480" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p11-evidence" value="EvidencePackageValidator&#xa;runtime-backed evidence only&#xa;redaction / claim scan / drawio XML&#xa;&#xa;planning docs cannot count as runtime evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1170" y="480" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p11-a1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#64748b;" edge="1" parent="1" source="p11-agent" target="p11-env">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11-a2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#64748b;" edge="1" parent="1" source="p11-env" target="p11-cap">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11-a3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#64748b;" edge="1" parent="1" source="p11-cap" target="p11-auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11-a4" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#64748b;" edge="1" parent="1" source="p11-auth" target="p11-exec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11-a5" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#64748b;" edge="1" parent="1" source="p11-exec" target="p11-orch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11-a6" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#64748b;" edge="1" parent="1" source="p11-orch" target="p11-evidence">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11-note" value="审计重点：Envelope 不是 runtime truth；Evidence Chain / Runtime Report 只读；Studio/BFF 不能绕过 CapabilityResolver；V9-8 不能在 V9-0..V9-7 evidence 缺失时执行。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="170" y="790" width="1260" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
