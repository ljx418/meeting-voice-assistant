        <mxCell id="cur_clients" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#38BDF8;align=left;spacingLeft=12;fontSize=13" value="用户入口层&lt;br&gt;&lt;br&gt;• 普通 CLI 可调用模型&lt;br&gt;• harness run / headless CLI 已可用&lt;br&gt;• --oh Textual TUI 已接入&lt;br&gt;• Web / API 仍是骨架" vertex="1">
          <mxGeometry height="95" width="400" x="70" y="200" as="geometry" />
        </mxCell>
        <mxCell id="cur_gateway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#38BDF8;align=left;spacingLeft=12;fontSize=13" value="Gateway / 协议边界&lt;br&gt;&lt;br&gt;• apps/gateway 已去 ohmo 化&lt;br&gt;• RpcRequest / RpcResponse / GatewayEvent&lt;br&gt;• session.start/resume/list/read/transcript&lt;br&gt;• turn.start/continue/interrupt/retry&lt;br&gt;• artifact.register/list/get/read&lt;br&gt;• trace.list/get 已完成&lt;br&gt;• approval.request/list/get/approve/reject 已完成&lt;br&gt;• policy.evaluate 已完成&lt;br&gt;• pack.list/get 已完成&lt;br&gt;• job.list/get/cancel 已完成&lt;br&gt;• FastAPI app.state GatewayService + Depends&lt;br&gt;• /v1/runs + SSE + /v1/rpc&lt;br&gt;• stdio JSONL server" vertex="1">
          <mxGeometry height="252.5" width="400" x="70" y="317.5" as="geometry" />
        </mxCell>
        <mxCell id="cur_orch" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#38BDF8;align=left;spacingLeft=12;fontSize=13" value="编排层&lt;br&gt;&lt;br&gt;• Lead Orchestrator MVP&lt;br&gt;• DomainWorkflow Registry&lt;br&gt;• Pack Registry MVP&lt;br&gt;• meeting.workflow 已注册&lt;br&gt;• knowledge.workflow MVP 已注册&lt;br&gt;• workflow.list 可查看 pack 元数据&lt;br&gt;• pack.list/get 可查看五个 pack&lt;br&gt;• 普通会议音频路径可自动路由" vertex="1">
          <mxGeometry height="150" width="400" x="70" y="590" as="geometry" />
        </mxCell>
        <mxCell id="cur_runtime" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#38BDF8;align=left;spacingLeft=12;fontSize=13" value="Runtime Adapter&lt;br&gt;&lt;br&gt;• RuntimeHandle / RuntimeAdapter MVP&lt;br&gt;• SimpleRuntimeAdapter：invoke&lt;br&gt;• OpenHarnessRuntimeAdapter：stream / continue&lt;br&gt;• GatewayRuntimePool 通过 adapter start / close&lt;br&gt;• snapshot + events.jsonl + transcript 保持兼容" vertex="1">
          <mxGeometry height="110" width="400" x="70" y="770" as="geometry" />
        </mxCell>
        <mxCell id="cur_exec" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#38BDF8;align=left;spacingLeft=12;fontSize=13" value="执行与治理&lt;br&gt;&lt;br&gt;• workspace/kb/artifact 基础工具&lt;br&gt;• Tool Policy Guard 已包住 builtin tools&lt;br&gt;• Core engine tool loop 可执行前阻断&lt;br&gt;• Artifact Registry 已登记会议产物&lt;br&gt;• TraceStore 已记录 turn/tool/artifact/workflow&lt;br&gt;• ApprovalStore 已记录 pending/approved/rejected&lt;br&gt;• PolicyEvaluator 已做 turn 预检审批 gate&lt;br&gt;• RetryStore 已支持 approved 后 turn.retry 续跑&lt;br&gt;• Secret Masker 已接入持久化边界&lt;br&gt;• Local persistence 已加锁 + 原子写" vertex="1">
          <mxGeometry height="190" width="400" x="70" y="910" as="geometry" />
        </mxCell>
        <mxCell id="gap_protocol" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;align=left;spacingLeft=12;fontSize=13" value="协议差距&lt;br&gt;&lt;br&gt;已完成：本地 RPC + FastAPI /v1/runs + SSE&lt;br&gt;已完成：artifact / trace / approval / policy / retry&lt;br&gt;已完成：Core protocol models + CoreAppService&lt;br&gt;已完成：Session / Thread / Turn / Item / Artifact / Trace / Approval / Retry 基础对象&lt;br&gt;已完成：session start/close Core-native mutation&lt;br&gt;已完成：turn/item Core-native mutation&lt;br&gt;已完成：session.get / thread.list / turn.get / turn.items&lt;br&gt;已完成：core.artifact.list / core.trace.list / core.approval.list / core.retry.list&lt;br&gt;需要补：Core-native RPC router" vertex="1">
          <mxGeometry height="220" width="400" x="600" y="190" as="geometry" />
