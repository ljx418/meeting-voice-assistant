        <mxCell id="p2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;align=center;spacing=6" value="契约层&lt;br&gt;MCP Primary Boundary&lt;br&gt;workspace / source / build / query&lt;br&gt;session / graph / trace / quality&lt;br&gt;CLI / HTTP 调用同一 service contract" vertex="1">
