        <mxCell id="roadmap_text" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;align=center;fontSize=14" value="V2.0 独立可打包服务 | V2.1 Remote MCP / HTTP Deployment | V2.2 Typed Retrieval + Citation | V2.x Interview / Learning / Code Understanding Adapters | V2.x Service Observability" vertex="1">
          <mxGeometry height="84" width="1480" x="260" y="2380" as="geometry" />
        </mxCell>

