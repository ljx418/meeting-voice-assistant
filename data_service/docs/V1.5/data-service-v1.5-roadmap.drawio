        </mxCell>
        <mxCell id="p5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;align=center;spacing=6" value="引擎层&lt;br&gt;LLMWiki Builder&lt;br&gt;GraphRAG Service&lt;br&gt;Session GraphRAG 下沉&lt;br&gt;Quality Governance read-time policy" vertex="1">
          <mxGeometry height="128" width="285" x="1430" y="465" as="geometry" />
