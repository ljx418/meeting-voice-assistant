        <mxCell id="p4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;align=center;spacing=6" value="处理流水线&lt;br&gt;Parser / Normalize / Distill&lt;br&gt;Typed Units v1.2&lt;br&gt;Entity &amp; Relation Extractor&lt;br&gt;Retrieval / Source Trace" vertex="1">
