        <mxCell id="p6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=13;align=center;spacing=6" value="存储层&lt;br&gt;Artifact Store / Local Workspace Store&lt;br&gt;内部 layout 可演进&lt;br&gt;外部只认 opaque IDs / refs" vertex="1">
          <mxGeometry height="128" width="220" x="1750" y="465" as="geometry" />
        </mxCell>
        <mxCell id="gov" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=13;align=center;spacing=6" value="治理链路贯穿 V1.5：workspace_id / session_id -&gt; source trace -&gt; operation -&gt; artifact_ref -&gt; quality feedback -&gt; correction plan -&gt; read-time governance" vertex="1">
          <mxGeometry height="70" width="1480" x="260" y="630" as="geometry" />
