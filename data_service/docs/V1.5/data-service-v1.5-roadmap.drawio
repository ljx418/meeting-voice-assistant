        <mxCell id="p3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;align=center;spacing=6" value="治理服务层&lt;br&gt;Knowledge Governance Service&lt;br&gt;Workspace &amp; Tenant Manager&lt;br&gt;Source Registry / Build Queue&lt;br&gt;Artifact Ref / Error Envelope" vertex="1">
