        <mxCell id="map_header" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=18;fontStyle=1" value="当前状态 -&gt; 核心差距 -&gt; V1.5 目标状态 -&gt; 阶段影响" vertex="1">
