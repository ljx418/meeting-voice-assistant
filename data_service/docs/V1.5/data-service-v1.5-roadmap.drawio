        <mxCell id="p1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontSize=13;align=center;spacing=6" value="入口层&lt;br&gt;External Apps / Agents / CLI / Console&lt;br&gt;会议、学习、面试、代码理解只作为消费者&lt;br&gt;不得 import data_service internals" vertex="1">
