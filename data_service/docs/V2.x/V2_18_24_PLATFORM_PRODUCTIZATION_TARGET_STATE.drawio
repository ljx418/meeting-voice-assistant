        <mxCell id="p20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=14;align=left;spacing=10;" value="V2.20 MCP Catalog&#xa;开发：tool catalog、goal-based workflow guide&#xa;验收：覆盖全部 tools，推荐链稳定，不推荐 missing tool" vertex="1">
          <mxGeometry height="130" width="360" x="980" y="120" as="geometry" />
