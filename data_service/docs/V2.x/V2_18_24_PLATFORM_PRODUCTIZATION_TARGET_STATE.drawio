        <mxCell id="p18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=14;align=left;spacing=10;" value="V2.18 Console UX&#xa;开发：统一控制台、状态视图、下一步建议&#xa;验收：真实 repo 生成 HTML，不隐藏 blocker，不新增事实" vertex="1">
