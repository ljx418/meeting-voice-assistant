  <diagram name="05 验收门槛及出门条件" id="v2_18_24_gates">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title5" value="V2.18-V2.24 验收门槛及出门条件" style="text;html=1;fontSize=28;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="700" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="必须通过&#xa;• 真实 data_service repo E2E&#xa;• Artifact validator&#xa;• HTTP/MCP/CLI parity&#xa;• Frontend build&#xa;• Security/redaction gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#16a34a;fontSize=15;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="360" height="260" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="必须拒绝&#xa;• Console 隐藏 blocker&#xa;• Provider unavailable 记 accepted&#xa;• Incremental build 静默跳过失败&#xa;• Governance 改写原始 artifact&#xa;• Tool guide 推荐不存在工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=15;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="520" y="120" width="360" height="260" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="出门条件&#xa;1. 用户能通过 Console 理解项目状态&#xa;2. Agent 能通过 Catalog 找到工具链&#xa;3. 产物有 schema 和 validator&#xa;4. 构建能解释复用/刷新/失效&#xa;5. Provider contract 清晰&#xa;6. Governance 可 approve/revoke&#xa;7. CI 能长期守住 contract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontSize=15;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="960" y="120" width="360" height="360" as="geometry" />
        </mxCell>
        <mxCell id="audit" value="每阶段流程&#xa;Development Plan → Acceptance Plan → Pre-implementation Audit → Implementation → Real Repo E2E → PRD/False-green Review → Acceptance Audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="160" y="590" width="1080" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="06 用户体验与具体场景" id="v2_18_24_ux">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title6" value="V2.18-V2.24 用户体验与具体应用场景" style="text;html=1;fontSize=28;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="760" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uxgoal" value="目标体验&#xa;用户能看懂项目；Agent 能找到工具；维护者能治理输出；大项目能增量刷新；CI 能守住契约。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontSize=18;fontStyle=1;align=center;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="170" y="100" width="1060" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ux1" value="场景 A：维护者打开 Console&#xa;看到项目摘要、入口、证据覆盖、blocker、下一步建议；不需要读 raw JSON。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=14;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="250" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ux2" value="场景 B：Agent 找工具链&#xa;输入 goal=coding_task_preparation，得到推荐 MCP 调用链、前置条件、失败恢复建议。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=14;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="250" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ux3" value="场景 C：大项目增量刷新&#xa;修改少量文件后输出 changed/reused/refreshed/invalidated，不静默跳过失败。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#16a34a;fontSize=14;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="960" y="250" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ux4" value="场景 D：Provider 能力判断&#xa;清楚看到 health/config/execution/status；optional unavailable 不会 fake accepted。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#16a34a;fontSize=14;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="450" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ux5" value="场景 E：治理反馈闭环&#xa;feedback → rule → approve → read-time overlay → revoke，源 artifact hash 不变。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=14;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="450" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ux6" value="场景 F：发布前检查&#xa;unit/contract/artifact/frontend/e2e 分层结果、warning budget、redaction gate、release conclusion。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=14;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="960" y="450" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="uxexit" value="用户验收门槛&#xa;1. 人类 5 分钟内能理解项目状态。&#xa;2. Agent 不需要人工翻 156 个工具。&#xa;3. 维护者能纠正错误输出并撤销规则。&#xa;4. 大项目刷新能解释复用和失效。&#xa;5. 发布前检查能阻止 redaction 和 contract 失败。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=16;fontStyle=1;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="250" y="660" width="900" height="150" as="geometry" />
        </mxCell>
