  <diagram id="v2_9_current_target_gap" name="01 当前vs目标架构差异">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title1" value="V2.9 当前 vs 目标架构差异" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="560" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="current" value="当前 V2.8 已验收能力&#xa;• 人类可读 HTML Dashboard&#xa;• 多层架构图与关键路径&#xa;• Code Fact Chain / Ranking / Intent&#xa;• Architecture Context Pack v2&#xa;• data_service E2E 通过&#xa;• HarnessOS 有图与报告" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#3B6EA8;fontSize=15;align=left;spacing=12" vertex="1" parent="1">
          <mxGeometry x="70" y="120" width="360" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="gap" value="已确认缺口&#xa;• HarnessOS accepted fact chains = 0&#xa;• 公开入口缺少稳定 line-level evidence&#xa;• 关系路径偏浅，难解释 capability -&gt; file&#xa;• Ranking 噪声偏高，pinned items 过多&#xa;• HTML 可读性仍不足，图表解释力不够&#xa;• Context Pack 未充分体现证据热度与风险" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#D9822B;fontSize=15;align=left;spacing=12" vertex="1" parent="1">
          <mxGeometry x="520" y="120" width="370" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="target" value="V2.9 目标能力&#xa;• Public Surface Evidence v2&#xa;• Code Relationship Layer v2&#xa;• Ranking Calibration v2&#xa;• Human Review Report v2&#xa;• Architecture Context Pack v3&#xa;• 双仓真实验收：data_service + HarnessOS&#xa;• 明确 unresolved / needs_review，不伪造通过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7EF;strokeColor=#2E8B57;fontSize=15;align=left;spacing=12" vertex="1" parent="1">
          <mxGeometry x="980" y="120" width="360" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;endArrow=block;endFill=1" edge="1" parent="1" source="current" target="gap">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;endArrow=block;endFill=1" edge="1" parent="1" source="gap" target="target">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="not_goal" value="V2.9 非目标 / 禁止声明&#xa;• 不做完整 call graph / data flow / control flow&#xa;• 不做 runtime tracing / type inference&#xa;• 不从代码完整恢复人类设计意图&#xa;• 不把 token overlap 标记为 accepted evidence&#xa;• 不把 copied diagrams 当成 code-derived evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7E8E8;strokeColor=#B85450;fontSize=15;align=left;spacing=12" vertex="1" parent="1">
          <mxGeometry x="300" y="470" width="800" height="170" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
