  <diagram id="v2_9_exit_gates" name="05 验收门槛及出门条件">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title5" value="V2.9 验收门槛与出门条件" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="30" width="560" height="40" as="geometry"/></mxCell>
        <mxCell id="gate1" value="真实数据门槛&#xa;• 必须跑 data_service + HarnessOS&#xa;• 不能用 mock repo 替代&#xa;• artifact 必须落盘并读回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#3B6EA8;fontSize=15;align=left;spacing=12" vertex="1" parent="1"><mxGeometry x="90" y="130" width="330" height="150" as="geometry"/></mxCell>
        <mxCell id="gate2" value="证据门槛&#xa;• accepted item 必须有 repo-relative path + line range&#xa;• line range 必须能从真实文件读出非空源码&#xa;• token-only / doc-only 不得 accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7EF;strokeColor=#2E8B57;fontSize=15;align=left;spacing=12" vertex="1" parent="1"><mxGeometry x="530" y="130" width="330" height="150" as="geometry"/></mxCell>
        <mxCell id="gate3" value="架构声明门槛&#xa;• 不声称 full call graph / data flow / runtime topology&#xa;• low confidence 必须进入 needs_review&#xa;• copied design diagrams 不得当作 code evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#D9822B;fontSize=15;align=left;spacing=12" vertex="1" parent="1"><mxGeometry x="970" y="130" width="330" height="150" as="geometry"/></mxCell>
        <mxCell id="gate4" value="安全与可读性门槛&#xa;• HTML / Mermaid 转义&#xa;• public output 不泄露绝对路径或 secret&#xa;• unresolved / needs_review 不能被隐藏&#xa;• 图表必须来自 persisted artifacts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E57C2;fontSize=15;align=left;spacing=12" vertex="1" parent="1"><mxGeometry x="250" y="390" width="390" height="170" as="geometry"/></mxCell>
        <mxCell id="exit" value="出门条件&#xa;• Phase 63-68 audit reports 无 open fatal/major&#xa;• Full coverage matrix 每个 accepted row 有测试 + artifact + baseline/ref/comparison&#xa;• HarnessOS caveat 被改善或明确记录 blocker&#xa;• HTTP/MCP/CLI success + error parity 通过&#xa;• V2.0-V2.8 artifact hash gate 通过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#777777;fontSize=15;align=left;spacing=12" vertex="1" parent="1"><mxGeometry x="750" y="390" width="430" height="190" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
