        <mxCell id="p63" value="Phase 63&#xa;Public Surface Evidence v2&#xa;阶段包：extractor catalog + V2.8 baseline gate&#xa;验收：line ranges 真实、类别覆盖、HarnessOS 不伪造 accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7EF;strokeColor=#2E8B57;fontSize=14;spacing=10" vertex="1" parent="1"><mxGeometry x="70" y="130" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="p64" value="Phase 64&#xa;Code Relationship Layer v2&#xa;阶段包：allowed relations + semantic_claim&#xa;验收：无 runtime/data/control claims、可解释 capability path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7EF;strokeColor=#2E8B57;fontSize=14;spacing=10" vertex="1" parent="1"><mxGeometry x="380" y="130" width="260" height="150" as="geometry"/></mxCell>
