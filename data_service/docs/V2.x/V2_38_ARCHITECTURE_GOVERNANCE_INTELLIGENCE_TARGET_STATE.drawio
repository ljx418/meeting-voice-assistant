        <mxCell id="e1" edge="1" source="cur" target="gap" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#64748b" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" edge="1" source="gap" target="target" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#64748b" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note1" value="不做过度承诺：V2.38-V2.45 不声称完整恢复人类设计意图；多语言、runtime、调用链都以 provider / candidate / evidence 方式逐步增强。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;fontSize=14" vertex="1" parent="1"><mxGeometry x="90" y="450" width="1180" height="90" as="geometry"/></mxCell>
