        <mxCell id="title1" value="V2.38 当前 vs 目标：从一次性架构核查到版本化增量架构治理" style="text;html=1;fontSize=24;fontStyle=1;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1160" height="40" as="geometry"/></mxCell>
