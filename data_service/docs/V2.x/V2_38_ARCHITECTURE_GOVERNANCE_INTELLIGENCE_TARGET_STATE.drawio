        <mxCell id="title5" value="V2.38 验收门槛及出门条件" style="text;html=1;fontSize=24;fontStyle=1;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="60" y="30" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="gate1" value="证据门槛&#xa;• supported 必须双边 evidence&#xa;• token_overlap_only 不能 supported&#xa;• code_not_documented 必须可见" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=14" vertex="1" parent="1"><mxGeometry x="80" y="120" width="340" height="140" as="geometry"/></mxCell>
        <mxCell id="gate2" value="泛化门槛&#xa;• data_service / HarnessOS / codexPat E2E&#xa;• HarnessOS 不能硬编码&#xa;• 不可用必须 structured blocker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=14" vertex="1" parent="1"><mxGeometry x="520" y="120" width="360" height="140" as="geometry"/></mxCell>
        <mxCell id="gate3" value="报告门槛&#xa;• 图表原位渲染&#xa;• 不展示 Mermaid 源码&#xa;• 不新增 artifact 外事实" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=14" vertex="1" parent="1"><mxGeometry x="980" y="120" width="340" height="140" as="geometry"/></mxCell>
        <mxCell id="gate4" value="Agent 门槛&#xa;• 输出任务级阅读路径&#xa;• 每条建议有证据或 needs_review&#xa;• 小 token budget 不保留无证据建议" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=14" vertex="1" parent="1"><mxGeometry x="280" y="340" width="390" height="150" as="geometry"/></mxCell>
        <mxCell id="gate5" value="出门条件&#xa;• V2.38 focused tests 通过&#xa;• public surface guard 通过&#xa;• 真实 E2E 通过或 structured unavailable&#xa;• 无 fatal / major finding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334155;fontSize=14" vertex="1" parent="1"><mxGeometry x="760" y="340" width="390" height="150" as="geometry"/></mxCell>
