        <mxCell id="p6t" value="用户体验与应用场景" style="text;html=1;fontSize=26;fontStyle=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6u1" value="场景 A：维护者阅读大型项目 用户导入 HarnessOS 后，看见规模、语言、入口候选、runtime/agent 候选、文档架构声明和弱证据区域。报告明确说明哪些是代码事实，哪些只是文档目标。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ecfdf5;strokeColor=#059669;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="420" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p6u2" value="场景 B：Coding Agent 定位任务 Agent 输入“修改某 workflow 执行链路”，系统返回 reading order、capability chain、相关文件/符号/测试、doc constraints，并用 token budget 控制上下文长度。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f3ff;strokeColor=#7c3aed;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="120" width="420" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p6u3" value="场景 C：架构审计者核查偏差 审计者查看 drawio/Markdown target claim 与 current code facts 的对齐结果，发现 unsupported/needs_review/contradicted 项，并追踪到 evidence 行号。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="120" width="420" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p6u4" value="用户能看到什么 - 架构关系图，不是目录枚举 - capability → entrypoint → handler → dependency → test/doc claim - token/cache/omitted_items 指标 - no-hardcode/profile/taxonomy 治理状态 - 每条结论的证据或 blocker" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#64748b;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="880" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p6u5" value="不能承诺什么 - 不能完全理解人类设计意图 - 不能恢复完整运行时拓扑 - 不能做完整调用图/数据流/控制流 - 不能把 HarnessOS 特化规则写进通用 extractor" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fef2f2;strokeColor=#dc2626;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="470" width="420" height="260" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
