        <mxCell id="cur" value="当前 V2.31-V2.36&#xa;事实层和任务导航已可用&#xa;但架构图偏目录/数量枚举" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D79B00;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="330" height="150" as="geometry"/></mxCell>
        <mxCell id="gap" value="主要缺口&#xa;1. docs 目标架构未重塑&#xa;2. 文档与代码未双边核查&#xa;3. HarnessOS workflow/runtime/agent 语义不清&#xa;4. 报告无法解释目标/当前/差异" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE4E2;strokeColor=#D92D20;fontSize=16;" vertex="1" parent="1"><mxGeometry x="500" y="120" width="420" height="190" as="geometry"/></mxCell>
        <mxCell id="target" value="V2.37 目标&#xa;从 docs 重塑目标架构&#xa;从代码事实生成当前实现&#xa;双边 evidence 核查&#xa;生成 target/current/diff/needs_review 报告" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#2E90FA;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1010" y="130" width="420" height="170" as="geometry"/></mxCell>
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#667085;" edge="1" parent="1" source="cur" target="gap"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#667085;" edge="1" parent="1" source="gap" target="target"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rule" value="边界：不承诺完整设计意图恢复、不做 full call graph、不做 HarnessOS 专用硬编码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#98A2B3;fontSize=16;" vertex="1" parent="1"><mxGeometry x="270" y="390" width="1040" height="90" as="geometry"/></mxCell>
