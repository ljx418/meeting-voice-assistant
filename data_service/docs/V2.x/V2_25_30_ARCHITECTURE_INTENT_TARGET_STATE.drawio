  </diagram>
  <diagram name="03 开发及验收计划" id="v2_25_30_plan">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t3" value="Phase 91-96 开发及验收计划" style="text;html=1;fontSize=28;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="720" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p91" value="Phase 91&#xa;Architecture Source Model&#xa;验收：data_service / HarnessOS source model 非空，repo-relative path，无路径泄露" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="210" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p92" value="Phase 92&#xa;Diagram-to-Claim Parser&#xa;验收：drawio/Mermaid/Markdown claim 可追踪 cell id 或 line range" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="300" y="130" width="210" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p93" value="Phase 93&#xa;Code Proof Graph&#xa;验收：code/config/test/runtime proof edge 有证据，禁止 runtime overclaim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="130" width="210" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p94" value="Phase 94&#xa;Intent Inference Engine&#xa;验收：每条意图候选有 evidence/counter evidence/confidence/needs_review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="780" y="130" width="210" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p95" value="Phase 95&#xa;Diagram-to-Code Verification&#xa;验收：accepted match 双边 evidence，非 token-only，confidence &gt;= 0.80" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1020" y="130" width="210" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p96" value="Phase 96&#xa;UX Report / Governance / Closure&#xa;验收：HTML + Context Pack + governance confirm/revoke + coverage matrix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1260" y="130" width="210" height="170" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="每阶段统一门槛&#xa;• Pre-implementation audit 无 fatal/major&#xa;• 真实仓库 E2E：data_service + HarnessOS&#xa;• Artifact 落盘并读回&#xa;• HTTP/MCP/CLI parity 或明确未暴露&#xa;• PRD 规格检视 + false-green review&#xa;• 不破坏 V2.18-V2.24 regression" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=16;align=left;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="250" y="430" width="1000" height="270" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
