          <mxGeometry x="40" y="30" width="760" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="M1 输入源统一&#xa;所有文档、图、代码、配置、测试、运行描述符成为可追踪 source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=15;" vertex="1" parent="1">
