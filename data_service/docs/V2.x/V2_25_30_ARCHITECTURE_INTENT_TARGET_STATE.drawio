          <mxGeometry x="300" y="430" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="M6 用户报告闭环&#xa;HTML、Mermaid、Context Pack、Governance、Coverage Matrix 完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="820" y="430" width="380" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="05 验收门槛与用户体验" id="v2_25_30_exit">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t5" value="验收门槛、出门条件与用户可体验能力" style="text;html=1;fontSize=28;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ux1" value="用户体验 A：Tech Lead 审查架构落地&#xa;看到目标架构图节点、代码证据、缺失项、冲突项、人工确认队列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=15;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="620" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ux2" value="用户体验 B：Coding Agent 准备开发任务&#xa;看到相关 intent、涉及模块、配置/测试证据、风险和下一步操作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=15;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="800" y="120" width="620" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ux3" value="用户体验 C：文档维护者检查设计文档&#xa;看到 target/plan/audit/historical 权威性、stale 文档、缺证据 claim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=15;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="620" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ux4" value="用户体验 D：维护者确认系统推断&#xa;confirm/reject/revoke 生成治理 overlay，不改写原始 artifacts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=15;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="800" y="320" width="620" height="150" as="geometry" />
        </mxCell>
        <mxCell id="exit" value="最终出门条件&#xa;• data_service 与 HarnessOS 均完成真实 E2E&#xa;• accepted match 必须双边 evidence + 非 token-only&#xa;• intent candidate 必须有 evidence/counter evidence/confidence&#xa;• HTML 报告展示 target/current/inferred/confirmed/diff&#xa;• Review Queue 不隐藏 weak/missing/conflict&#xa;• public payload 无路径/secret/traceback 泄露&#xa;• coverage matrix 无 open fatal/major" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;fontSize=16;align=left;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="270" y="570" width="960" height="290" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
