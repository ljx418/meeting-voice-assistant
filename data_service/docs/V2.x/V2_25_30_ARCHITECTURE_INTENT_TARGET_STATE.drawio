        <mxCell id="m4" value="M4 意图候选可信&#xa;每条意图显示证据、反证、置信度和人工复核状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=15;" vertex="1" parent="1">
