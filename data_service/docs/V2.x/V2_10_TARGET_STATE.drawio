        <mxCell id="cur" value="当前 V2.9&#xa;- data_service: 374 accepted evidence&#xa;- HarnessOS: 120 candidates, LINE_RANGE_INVALID&#xa;- 可以拒绝假通过，但不能解析大型项目特定架构模式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00" vertex="1" parent="1"><mxGeometry x="70" y="120" width="420" height="190" as="geometry"/></mxCell>
        <mxCell id="target" value="目标 V2.10&#xa;- Pattern Adapter Registry&#xa;- AST Registry/Decorator/Class Binding&#xa;- Definition Lookup&#xa;- Manifest Candidate Resolver&#xa;- Controlled Runtime Candidate Importer&#xa;- Evidence Acceptance Gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#2e7d32" vertex="1" parent="1"><mxGeometry x="660" y="120" width="440" height="220" as="geometry"/></mxCell>
        <mxCell id="gap" value="差异：大型项目架构入口不一定是 HTTP/MCP/argparse；需要泛用 pattern 层把 registry/workflow/adapter/agent/manifest 绑定到真实源码行号" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8" vertex="1" parent="1"><mxGeometry x="240" y="430" width="700" height="100" as="geometry"/></mxCell>
