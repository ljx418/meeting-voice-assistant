  <diagram id="v25b-gates" name="05 验收门槛及出门条件">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="V2.5B 验收门槛与出门条件" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111827;fontColor=#ffffff;strokeColor=#374151;fontSize=24;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
        <mxCell id="gate1" value="真实输入门槛&#xa;scanned PDF 必须是真扫描件并自动证明无 embedded text；external TTS 必须有真实 provider audio；cloud OCR accepted 必须有 real fixture；download contract 必须有真实 artifact inspection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=15;align=left;spacing=14" vertex="1" parent="1"><mxGeometry x="80" y="160" width="500" height="220" as="geometry"/></mxCell>
        <mxCell id="gate2" value="Provider 门槛&#xa;health name 不等于 execution support；known health + no adapter 必须负向测试；unsupported/missing key/auth/timeout/quota/bad response 均结构化；provider unavailable 不可写成 accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=15;align=left;spacing=14" vertex="1" parent="1"><mxGeometry x="650" y="160" width="500" height="220" as="geometry"/></mxCell>
        <mxCell id="gate3" value="安全门槛&#xa;public payload 不泄露 API key、token、endpoint、raw traceback、absolute path；binary 只暴露 artifact:// 或已批准 stream URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=15;align=left;spacing=14" vertex="1" parent="1"><mxGeometry x="1220" y="160" width="500" height="220" as="geometry"/></mxCell>
        <mxCell id="gate4" value="兼容门槛&#xa;V2.5A local provider suite 继续通过；provider-disabled fallback 继续通过；Slides/Mindmap/Compare real-doc artifacts 不回退" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=15;align=left;spacing=14" vertex="1" parent="1"><mxGeometry x="80" y="460" width="500" height="220" as="geometry"/></mxCell>
        <mxCell id="gate5" value="虚假验收拒绝&#xa;embedded-text PDF 冒充 scanned OCR；empty audio；JSON 改名 PPTX；mock-only provider success；skipped provider test counted as accepted；descriptor-only claimed as stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=15;align=left;spacing=14" vertex="1" parent="1"><mxGeometry x="650" y="460" width="500" height="220" as="geometry"/></mxCell>
        <mxCell id="exit" value="Full PRD 出门条件&#xa;1. Phase 37 Pre-Gate + Phase 37-42 reports exist&#xa;2. PRD coverage matrix complete 且字段齐全&#xa;3. accepted rows all have evidence&#xa;4. provider unavailable rows explicit&#xa;5. 每阶段 provider matrix 更新&#xa;6. V2.5A regression 全阶段保留&#xa;7. no fatal/major finding&#xa;8. no accepted claim depends on mock-only evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4f46e5;fontSize=16;align=left;spacing=16" vertex="1" parent="1"><mxGeometry x="1220" y="460" width="500" height="300" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
