  <diagram id="v25b-gap" name="01 当前vs全量目标差异">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="V2.5 当前状态 vs 原始 PRD 全量目标&#xa;V2.5A 已闭环：本地 provider MVP&#xa;V2.5B 待闭环：Full ResearchNotebook Backend PRD" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111827;fontColor=#ffffff;strokeColor=#374151;fontSize=24;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="90" as="geometry"/></mxCell>
        <mxCell id="current" value="当前已验收 V2.5A&#xa;&#xa;P0 SSRF + block_reason&#xa;provider-disabled fallback&#xa;Slides / Mindmap / Compare deterministic artifacts&#xa;Tesseract image OCR&#xa;espeak-ng WAV audio&#xa;OpenXML PPTX package&#xa;safe artifact descriptors&#xa;&#xa;明确未声称：cloud OCR/TTS、full scanned PDF success、direct binary stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=15;align=left;spacing=14" vertex="1" parent="1"><mxGeometry x="80" y="170" width="700" height="440" as="geometry"/></mxCell>
        <mxCell id="target" value="V2.5B 全量 PRD 目标&#xa;&#xa;Phase 37 Pre-Gate provider execution contract freeze&#xa;Phase 37 scanned PDF OCR success&#xa;Phase 38 provider adapter contract&#xa;Phase 39 external TTS real run&#xa;Phase 40 external OCR decision/run&#xa;Phase 41 download contract closure&#xa;Phase 42 full PRD coverage audit&#xa;&#xa;目标：所有原始 PRD 项都有 accepted / provider unavailable / out of scope 明确结论" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=15;align=left;spacing=14" vertex="1" parent="1"><mxGeometry x="1020" y="170" width="700" height="440" as="geometry"/></mxCell>
        <mxCell id="gap" value="关键差异&#xa;1. 图片 OCR → 扫描 PDF OCR 成功&#xa;2. Provider health name → executable adapter support&#xa;3. Local TTS → 至少一个 external TTS real run 或明确 unavailable&#xa;4. Tesseract-only OCR → cloud OCR 决策和可选真实运行&#xa;5. Safe descriptor → 明确是否需要直接二进制流下载&#xa;6. Phase 36 local closure → Phase 42 full PRD coverage closure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=15;align=left;spacing=14" vertex="1" parent="1"><mxGeometry x="320" y="710" width="1160" height="240" as="geometry"/></mxCell>
        <mxCell id="edge" style="endArrow=block;html=1;strokeColor=#64748b;strokeWidth=3" edge="1" parent="1" source="current" target="target"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
