  <diagram id="v25b-plan" name="03 Phase37-42开发验收">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="V2.5B Phase 37-42 开发及验收计划" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111827;fontColor=#ffffff;strokeColor=#374151;fontSize=24;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
        <mxCell id="p37" value="Phase 37 Pre-Gate + Phase 37&#xa;Scanned PDF OCR Success&#xa;&#xa;开发前：冻结 ProviderExecutionResult / ArtifactWriteResult&#xa;开发：真实扫描 PDF fixture / rasterizer / OCR artifact&#xa;验收：自动证明非 embedded text；四路读回一致；fallback 不回退" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=14;align=left;spacing=12" vertex="1" parent="1"><mxGeometry x="70" y="160" width="270" height="250" as="geometry"/></mxCell>
        <mxCell id="p38" value="Phase 38&#xa;Provider Adapter Contract&#xa;&#xa;开发：execution adapter registry；health != execution；failure matrix&#xa;验收：known health + no adapter → PROVIDER_UNSUPPORTED；unsupported 不得 fallback local" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=14;align=left;spacing=12" vertex="1" parent="1"><mxGeometry x="390" y="160" width="270" height="250" as="geometry"/></mxCell>
        <mxCell id="p39" value="Phase 39&#xa;External TTS Real Run&#xa;&#xa;开发：Minimax 或 Azure/Google/ElevenLabs adapter&#xa;验收：真实音频 binary；size/sha256/mime/duration；bad key/timeout redacted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=14;align=left;spacing=12" vertex="1" parent="1"><mxGeometry x="710" y="160" width="270" height="230" as="geometry"/></mxCell>
        <mxCell id="p40" value="Phase 40&#xa;External OCR Decision/Run&#xa;&#xa;开发：Azure/Google/Minimax OCR 决策；可用则真实运行&#xa;验收：cloud OCR 无 key 只能 unavailable；有 key 必须 real fixture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=14;align=left;spacing=12" vertex="1" parent="1"><mxGeometry x="1030" y="160" width="270" height="230" as="geometry"/></mxCell>
        <mxCell id="p41" value="Phase 41&#xa;Download Contract Closure&#xa;&#xa;开发：descriptor-only vs direct stream 决策；错误形态&#xa;验收：mime/size/sha256/status 一致；missing/unauthorized/unsupported format 结构化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=14;align=left;spacing=12" vertex="1" parent="1"><mxGeometry x="1350" y="160" width="270" height="230" as="geometry"/></mxCell>
        <mxCell id="p42" value="Phase 42&#xa;Full PRD Closure Audit&#xa;&#xa;开发：coverage matrix / final provider matrix / false-acceptance review&#xa;验收：每个原始 PRD 项都有状态和 evidence；无 fatal/major" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4f46e5;fontSize=15;align=left;spacing=12" vertex="1" parent="1"><mxGeometry x="480" y="610" width="850" height="220" as="geometry"/></mxCell>
        <mxCell id="e1" style="endArrow=block;html=1;strokeColor=#64748b;strokeWidth=2" edge="1" parent="1" source="p37" target="p38"><mxGeometry relative="1" as="geometry"/></mxCell>
