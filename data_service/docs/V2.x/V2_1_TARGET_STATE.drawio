  <diagram id="v2-1-devwiki" name="03 Phase8-DevWiki验收">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Phase 8 DevWiki Baseline：目标状态与验收标准" style="text;html=1;strokeColor=none;fillColor=none;fontSize=32;fontStyle=1;fontColor=#0F172A;align=center;" vertex="1" parent="1">
          <mxGeometry x="220" y="40" width="1760" height="60" as="geometry" />
        </mxCell>
        <mxCell id="input" value="&lt;b&gt;输入&lt;/b&gt;&lt;br&gt;&lt;br&gt;V2.0 artifacts：overview、inventory、symbols、imports、trace、context metadata&lt;br&gt;&lt;br&gt;必须来自真实 repo，不接受 mock-only。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=15;align=center;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="340" height="230" as="geometry" />
        </mxCell>
        <mxCell id="build" value="&lt;b&gt;生成流程&lt;/b&gt;&lt;br&gt;&lt;br&gt;Page Planner&lt;br&gt;→ Page Builder&lt;br&gt;→ JSON Model&lt;br&gt;→ Markdown Renderer&lt;br&gt;→ Index + Pages Persistence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontSize=15;align=center;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="570" y="210" width="360" height="250" as="geometry" />
        </mxCell>
        <mxCell id="pages" value="&lt;b&gt;必需页面&lt;/b&gt;&lt;br&gt;&lt;br&gt;project-overview&lt;br&gt;architecture&lt;br&gt;public-surface&lt;br&gt;http-api / mcp-tools / cli&lt;br&gt;storage&lt;br&gt;build-pipeline&lt;br&gt;developer-onboarding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontSize=15;align=center;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1080" y="210" width="340" height="250" as="geometry" />
        </mxCell>
        <mxCell id="artifacts" value="&lt;b&gt;产物&lt;/b&gt;&lt;br&gt;&lt;br&gt;devwiki/index.json&lt;br&gt;pages/{slug}.json&lt;br&gt;pages/{slug}.md&lt;br&gt;&lt;br&gt;字段：snapshot_id、sections、evidence、needs_review、stale、confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontSize=15;align=center;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1570" y="210" width="430" height="250" as="geometry" />
        </mxCell>
        <mxCell id="interfaces" value="&lt;b&gt;公开入口&lt;/b&gt;&lt;br&gt;HTTP：devwiki build / pages / page read&lt;br&gt;MCP：knowledge_devwiki_build / read&lt;br&gt;CLI：knowledge code devwiki build/pages/read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;fontSize=16;align=center;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="310" y="670" width="740" height="150" as="geometry" />
        </mxCell>
        <mxCell id="accept" value="&lt;b&gt;验收标准&lt;/b&gt;&lt;br&gt;9 个页面全部生成；JSON/Markdown 一致；每个重要结论有 evidence 或 needs_review；page read 三端字段一致；无绝对路径泄露；不污染 source registry。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#14B8A6;fontSize=16;fontStyle=1;align=center;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1160" y="650" width="760" height="190" as="geometry" />
        </mxCell>
        <mxCell id="stop" value="&lt;b&gt;停止条件&lt;/b&gt;&lt;br&gt;需要 LLM-only prose；页面无法绑定 evidence；DevWiki 语义与 V1 LLMWiki 混淆；实现要塞入 data_service.py / service.py。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontSize=16;fontStyle=1;align=center;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="430" y="1030" width="1340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="input" target="build" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=block;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="build" target="pages" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=block;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="pages" target="artifacts" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=block;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="artifacts" target="accept" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=block;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2-1-graph" name="04 Phase9-CodeGraph验收">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Phase 9 Code Graph Baseline：目标状态与验收标准" style="text;html=1;strokeColor=none;fillColor=none;fontSize=32;fontStyle=1;fontColor=#0F172A;align=center;" vertex="1" parent="1">
          <mxGeometry x="220" y="40" width="1760" height="60" as="geometry" />
        </mxCell>
        <mxCell id="input" value="&lt;b&gt;输入&lt;/b&gt;&lt;br&gt;&lt;br&gt;snapshot files&lt;br&gt;symbols / imports&lt;br&gt;surfaces / capabilities&lt;br&gt;evidence trace&lt;br&gt;DevWiki pages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=15;align=center;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="230" width="310" height="240" as="geometry" />
        </mxCell>
        <mxCell id="nodes" value="&lt;b&gt;节点&lt;/b&gt;&lt;br&gt;&lt;br&gt;Codebase / Snapshot / Folder / File&lt;br&gt;Module / Class / Function / Method&lt;br&gt;HTTPRoute / MCPTool / CLICommand&lt;br&gt;Capability / DevWikiPage / EvidenceSpan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontSize=15;align=center;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="550" y="170" width="420" height="240" as="geometry" />
        </mxCell>
        <mxCell id="edges" value="&lt;b&gt;边&lt;/b&gt;&lt;br&gt;&lt;br&gt;CONTAINS / DEFINES / IMPORTS&lt;br&gt;EXPOSES_ROUTE / REGISTERS_MCP_TOOL / EXPOSES_CLI_COMMAND&lt;br&gt;HANDLED_BY / IMPLEMENTS_CAPABILITY&lt;br&gt;DOCUMENTED_BY / EVIDENCED_BY / GENERATED_FROM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#14B8A6;fontSize=15;align=center;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="550" y="520" width="420" height="260" as="geometry" />
        </mxCell>
        <mxCell id="artifacts" value="&lt;b&gt;产物&lt;/b&gt;&lt;br&gt;&lt;br&gt;graph.json&lt;br&gt;nodes.jsonl&lt;br&gt;edges.jsonl&lt;br&gt;summary.json&lt;br&gt;mermaid/project.mmd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontSize=15;align=center;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1160" y="280" width="330" height="240" as="geometry" />
        </mxCell>
        <mxCell id="reads" value="&lt;b&gt;读取 / 导出&lt;/b&gt;&lt;br&gt;&lt;br&gt;graph snapshot&lt;br&gt;neighbors&lt;br&gt;Mermaid&lt;br&gt;HTTP / MCP / CLI / Frontend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;fontSize=15;align=center;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1660" y="280" width="330" height="240" as="geometry" />
        </mxCell>
        <mxCell id="accept" value="&lt;b&gt;验收标准&lt;/b&gt;&lt;br&gt;核心 node/edge types 存在；neighbors 覆盖 file/symbol/surface/capability/devwiki/evidence；Mermaid 非空；edge 有 extractor/confidence/evidence；三端读取字段一致。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontSize=16;fontStyle=1;align=center;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="280" y="950" width="760" height="180" as="geometry" />
        </mxCell>
