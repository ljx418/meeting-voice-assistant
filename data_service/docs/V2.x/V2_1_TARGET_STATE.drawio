  <diagram id="v2-1-governance" name="05 Phase10-12治理前端收口">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Phase 10-12：质量治理、只读前端与 V2.1 收口验收" style="text;html=1;strokeColor=none;fillColor=none;fontSize=32;fontStyle=1;fontColor=#0F172A;align=center;" vertex="1" parent="1">
          <mxGeometry x="220" y="40" width="1760" height="60" as="geometry" />
        </mxCell>
        <mxCell id="targets" value="&lt;b&gt;Phase 10 治理对象&lt;/b&gt;&lt;br&gt;&lt;br&gt;DevWiki page / section&lt;br&gt;public surface / capability&lt;br&gt;code symbol / graph edge&lt;br&gt;context pack item" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=15;align=center;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="320" height="230" as="geometry" />
        </mxCell>
        <mxCell id="quality" value="&lt;b&gt;Phase 10 质量流程&lt;/b&gt;&lt;br&gt;&lt;br&gt;feedback&lt;br&gt;→ draft rules&lt;br&gt;→ review approve/reject/revoke&lt;br&gt;→ correction plan&lt;br&gt;→ read-time consumption" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontSize=15;align=center;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="560" y="190" width="360" height="270" as="geometry" />
        </mxCell>
        <mxCell id="frontend" value="&lt;b&gt;Phase 11 只读前端&lt;/b&gt;&lt;br&gt;&lt;br&gt;DevWiki 页面列表/详情&lt;br&gt;Graph 摘要 + Mermaid&lt;br&gt;Quality summary + plan impact&lt;br&gt;Context Pack 回读&lt;br&gt;&lt;br&gt;构建：npm run build --prefix frontend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;fontSize=15;align=center;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1080" y="190" width="400" height="270" as="geometry" />
        </mxCell>
        <mxCell id="closure" value="&lt;b&gt;Phase 12 收口&lt;/b&gt;&lt;br&gt;&lt;br&gt;真实仓库 E2E&lt;br&gt;full backend tests&lt;br&gt;frontend build&lt;br&gt;artifact inspection&lt;br&gt;artifact hash gate&lt;br&gt;cross-link / schema validation&lt;br&gt;HTTP/MCP/CLI convergence&lt;br&gt;PRD/spec/false-acceptance audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=15;align=center;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1640" y="190" width="380" height="270" as="geometry" />
        </mxCell>
        <mxCell id="accept10" value="&lt;b&gt;Phase 10 验收&lt;/b&gt;&lt;br&gt;能记录 feedback；能生成 draft rule；能审核 / revoke rule；能生成 plan；approved rule 不改原始 artifact，只以 read-time overlay 影响 DevWiki / Graph / Context 输出；hash 前后不变。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;fontSize=16;fontStyle=1;align=center;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="170" y="720" width="560" height="180" as="geometry" />
        </mxCell>
        <mxCell id="accept11" value="&lt;b&gt;Phase 11 验收&lt;/b&gt;&lt;br&gt;前端是 API-backed read-only review surface；不做图谱编辑器；不产生前端独有事实；桌面/移动文本不重叠；frontend build 通过。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;fontSize=16;fontStyle=1;align=center;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="830" y="720" width="560" height="180" as="geometry" />
        </mxCell>
        <mxCell id="accept12" value="&lt;b&gt;Phase 12 验收&lt;/b&gt;&lt;br&gt;backend tests、frontend build、git diff --check 全部通过；V2.1 artifacts 可读回；无 fatal/major finding；形成 closure audit。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontSize=16;fontStyle=1;align=center;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1490" y="720" width="560" height="180" as="geometry" />
        </mxCell>
        <mxCell id="stop" value="&lt;b&gt;统一停止条件&lt;/b&gt;&lt;br&gt;出现 PRD 重大偏差、虚假验收风险、无法用真实仓库验收、关键结论无 evidence/needs_review、或需要扩大旧大文件职责边界时，停止并回到计划阶段。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontSize=17;fontStyle=1;align=center;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="350" y="1080" width="1500" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="targets" target="quality" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=block;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="quality" target="frontend" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=block;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="frontend" target="closure" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=block;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
